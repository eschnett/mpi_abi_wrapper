# pkg-config metadata for mpi_abi, generated by CMake from cmake/mpi_abi.pc.in.
#
# The third of the three consumption routes NOTES.md #9 requires, beside
# find_package(mpi_abi) (cmake/mpi_abiConfig.cmake.in) and bin/mpicc
# (bin/mpicc.in). All three publish one flag inventory; every *value* comes
# from the same CMake variable, but the shape of the line is written out
# three times, so ci-scripts/check-install.sh compiles, links and runs
# against each of them rather than trusting that they agree.
#
# The rpath is here on purpose: -Wl,-rpath,${libdir} is what lets a program
# linked with `pkg-config --libs mpi_abi` start with LD_LIBRARY_PATH and
# DYLD_LIBRARY_PATH cleared, the same property bin/mpicc gives its own
# programs. A packager who does not want it (a prefix of /usr, say) has to
# edit this file -- pkg-config strips -L/usr/lib but nothing strips
# -Wl,-rpath,/usr/lib, and `--define-variable=x=` with an empty value is a
# hard error, so no knob could have been offered here.

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: @PROJECT_DESCRIPTION@
URL: @CMAKE_PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -Wl,-rpath,${libdir} -lmpi_abi
